<UserControl x:Class="StructLab.Views.Lab01.Lab01View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:StructLab.ViewModels.Lab01"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.DataContext>
        <vm:Lab01ViewModel/>
    </UserControl.DataContext>

    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="20" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <materialDesign:DialogHost Identifier="Lab01Dialog"
                                IsOpen="{Binding IsAddDialogOpen, Mode=TwoWay}">

        <materialDesign:DialogHost.DialogContent>
            <materialDesign:Card UniformCornerRadius="16" Width="520">
                <StackPanel>

                    <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="16,16,0,0"
                            Padding="24,20">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookPlus"
                                                      Width="28" Height="28"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Добавить книгу"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="24,20,24,8">

                        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Автор"
                                 Text="{Binding NewBook.Author, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Название"
                                 Text="{Binding NewBook.Title, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Жанр"
                                 Text="{Binding NewBook.Genre, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Год издания"
                                     Text="{Binding NewBook.Year, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox Grid.Column="2"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Страниц"
                                     Text="{Binding NewBook.Pages, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Количество экземпляров"
                                 Text="{Binding NewBook.Copies, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>

                        <Border Background="#FEE2E2"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,4,0,0"
                                Visibility="{Binding NewBookError, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                          Width="18" Height="18"
                                                          Foreground="{StaticResource ErrorBrush}"
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NewBookError}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           Margin="8,0,0,0"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="0,0,16,16"
                            Padding="24,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding CancelAddCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Добавить"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding ConfirmAddCommand}"
                                    IsDefault="True"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </materialDesign:Card>
        </materialDesign:DialogHost.DialogContent>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,40,48,40" MaxWidth="1100">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="8"
                            Width="56" Height="56">
                        <TextBlock Text="1"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Библиотека"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Учёт книг · Динамический список"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <materialDesign:Card Padding="16" UniformCornerRadius="12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding OpenAddDialogCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                                <TextBlock Text="Добавить" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding AddSortedCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Отсортировать по названию">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SortAlphabeticalAscending" VerticalAlignment="Center"/>
                                <TextBlock Text="Сортировать" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding DeleteSelectedCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Удалить выбранную книгу">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" VerticalAlignment="Center"/>
                                <TextBlock Text="Удалить" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ClearAllCommand}"
                                ToolTip="Очистить всю картотеку">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteSweepOutline" VerticalAlignment="Center"/>
                                <TextBlock Text="Очистить" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <TextBlock VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Всего книг:"/>
                            <Run Text="{Binding Books.Count, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="0" UniformCornerRadius="12">
                    <DataGrid ItemsSource="{Binding Books}"
                              SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderThickness="0"
                              RowHeight="44"
                              ColumnHeaderHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="*"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="120"/>
                            <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="80"/>
                            <DataGridTextColumn Header="Стр." Binding="{Binding Pages}" Width="80"/>
                            <DataGridTextColumn Header="Экз." Binding="{Binding Copies}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

    </materialDesign:DialogHost>
</UserControl>