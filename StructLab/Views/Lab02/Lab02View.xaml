<UserControl x:Class="StructLab.Views.Lab02.Lab02View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:StructLab.ViewModels.Lab02"
             xmlns:models="clr-namespace:StructLab.Models.Lab02"
             xmlns:behaviors="clr-namespace:StructLab.Behaviors"
             Background="{DynamicResource AppBackgroundBrush}"
             behaviors:ButtonSquash.IsEnabled="True">

    <UserControl.DataContext>
        <vm:Lab02ViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- Горизонтальный разделитель (задачи ↔ деревья) -->
        <Style x:Key="GripRowSplitter" TargetType="GridSplitter">
            <Setter Property="Height" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Background="{DynamicResource TextSecondaryBrush}"
                                    Height="4" Width="80" CornerRadius="2" Opacity="0.4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вертикальный разделитель (BST ↔ AVL) -->
        <Style x:Key="GripColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Background="{DynamicResource TextSecondaryBrush}"
                                    Width="4" Height="60" CornerRadius="2" Opacity="0.4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="20" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>

        <!-- ============ DialogHost для сервисных диалогов ============ -->
        <materialDesign:DialogHost Identifier="Lab02Dialogs">

            <Grid>

                <!-- ============================================================ -->
                <!-- ОСНОВНОЙ ДИАЛОГ (ДОБАВЛЕНИЕ, СРОЧНЫЕ)                         -->
                <!-- ============================================================ -->
                <materialDesign:DialogHost Identifier="Lab02Dialog" IsOpen="{Binding IsAnyDialogOpen, Mode=TwoWay}">
                    <materialDesign:DialogHost.DialogContent>
                        <Grid>
                            <!-- ===== ДОБАВЛЕНИЕ ЗАДАЧИ ===== -->
                            <materialDesign:Card UniformCornerRadius="16" Width="540"
                                                 Visibility="{Binding IsAddDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="16,16,0,0" Padding="24,20">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="PlaylistPlus" Width="28" Height="28"
                                                                      Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="Новая задача" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="24,20,24,8">
                                        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 materialDesign:HintAssist.Hint="Что нужно сделать"
                                                 Text="{Binding NewTask.Title, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,16"/>

                                        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 materialDesign:HintAssist.Hint="Описание (необязательно)"
                                                 Text="{Binding NewTask.Description, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,16"/>

                                        <!-- 3 КОЛОНКИ: Приоритет / Дата / Время -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Приоритет (1–10)" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Slider Value="{Binding NewTask.Priority, Mode=TwoWay}"
                                                        Minimum="1" Maximum="10"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        TickPlacement="BottomRight"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Дата (yyyy-MM-dd)" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         materialDesign:HintAssist.Hint="2026-11-15"
                                                         Text="{Binding NewTask.DueDate, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Время (HH:mm)" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         materialDesign:HintAssist.Hint="14:30"
                                                         Text="{Binding NewTask.DueTime, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="#FEE2E2" CornerRadius="6" Padding="12,8" Margin="0,4,0,0"
                                                Visibility="{Binding NewTaskError, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding NewTaskError}"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       FontSize="12" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="0,0,16,16" Padding="24,16">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Отмена" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Command="{Binding CancelAddCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Добавить" Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Command="{Binding ConfirmAddCommand}" IsDefault="True"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- ===== СРОЧНЫЕ ЗАДАЧИ ===== -->
                            <materialDesign:Card UniformCornerRadius="16" Width="560"
                                                 Visibility="{Binding IsUrgentDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="16,16,0,0" Padding="24,20">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Fire" Width="28" Height="28"
                                                                      Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="Срочные задачи" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <Border Background="White" CornerRadius="10" Padding="8,2"
                                                    Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UrgentTasks.Count}"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontWeight="Bold" FontSize="13"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="24,20,24,8">
                                        <TextBlock Text="Топ-10 самых приоритетных невыполненных задач."
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                                        <TextBlock Text="{Binding UrgentMessage}"
                                                   FontSize="14" FontStyle="Italic"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding UrgentMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                                   Margin="0,8,0,8"/>

                                        <ItemsControl ItemsSource="{Binding UrgentTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppBackgroundBrush}"
                                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Background="{Binding NodeColor}"
                                                                    CornerRadius="4" Padding="10,4"
                                                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Priority}" Foreground="White"
                                                                           FontWeight="Bold" FontSize="13"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                <TextBlock Text="{Binding DueDisplay}" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Right"
                                                                           Visibility="{Binding DueDisplay, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="0,0,16,16" Padding="24,16">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Закрыть" Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Command="{Binding CloseUrgentCommand}" IsDefault="True" Width="120"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </materialDesign:Card>
                        </Grid>
                    </materialDesign:DialogHost.DialogContent>

                    <!-- ============================================================ -->
                    <!-- ОСНОВНОЙ КОНТЕНТ ЛАБЫ                                        -->
                    <!-- ============================================================ -->
                    <Grid Margin="32,28,32,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ЗАГОЛОВОК -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Width="56" Height="56">
                                    <TextBlock Text="2" FontSize="28" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Деревья" FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Менеджер задач · BST vs AVL"
                                               FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,8"
                                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                                        ToolTip="Статистика BST">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileTree" Width="18" Height="18"
                                                                  Foreground="{StaticResource PrimaryBrush}"
                                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BstInfo}" Margin="8,0,0,0"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,8"
                                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                        Margin="10,0,0,0"
                                        ToolTip="Статистика AVL">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileTree" Width="18" Height="18"
                                                                  Foreground="{StaticResource SuccessBrush}"
                                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AvlInfo}" Margin="8,0,0,0"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ПАНЕЛЬ КНОПОК -->
                        <materialDesign:Card Grid.Row="1" Padding="16,12" UniformCornerRadius="12" Margin="0,0,0,16">
                            <WrapPanel behaviors:StaggeredEntrance.IsEnabled="True">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding OpenAddDialogCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                                        <TextBlock Text="Новая задача" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding ExportTasksCommand}" Margin="0,0,8,8"
                                        ToolTip="Сохранить копию списка задач в выбранный файл">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExport" VerticalAlignment="Center"/>
                                        <TextBlock Text="Экспорт" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding ShowUrgentCommand}" Margin="0,0,8,8"
                                        ToolTip="Показать топ-10 самых срочных">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Fire" VerticalAlignment="Center"/>
                                        <TextBlock Text="Срочные" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Width="1" Fill="{DynamicResource TextSecondaryBrush}"
                                           Opacity="0.3" Margin="8,4"/>

                                <TextBlock Text="Демонстрация:" VerticalAlignment="Center" Margin="8,0,8,8"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <TextBlock Text="{Binding PoolStatusText}" VerticalAlignment="Center" Margin="0,0,12,8"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding AddRandom10Command}" Margin="0,0,8,8"
                                        IsEnabled="{Binding CanRandomize}"
                                        ToolTip="Добавить 10 случайных задач">
                                    <TextBlock Text="+10"/>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding AddRandom50Command}" Margin="0,0,8,8"
                                        IsEnabled="{Binding CanRandomize}"
                                        ToolTip="Добавить 50 случайных задач">
                                    <TextBlock Text="+50"/>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding AddRandom100Command}" Margin="0,0,8,8"
                                        IsEnabled="{Binding CanRandomize}"
                                        ToolTip="Добавить 100 случайных задач">
                                    <TextBlock Text="+100"/>
                                </Button>

                                <!-- ЗАМЕНА КНОПКИ ДЕГРАДАЦИИ НА TOGGLEBUTTON -->
                                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6"
                                        Padding="10,4" Margin="0,0,8,8" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="{Binding DegradeIcon}" 
                                                VerticalAlignment="Center" 
                                                Margin="0,0,6,0"
                                                Foreground="{StaticResource PrimaryBrush}"/>

                                        <TextBlock Text="{Binding DegradeLabel}" 
                                                   VerticalAlignment="Center" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource PrimaryBrush}" 
                                                   Margin="0,0,8,0"/>

                                        <!-- Сам переключатель без лишнего контента внутри -->
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                      IsChecked="{Binding IsDegraded, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanRandomize}"
                                                      ToolTip="Деградация = sequential ID (BST вырождается). Нормализация = случайные ID."/>
                                    </StackPanel>
                                </Border>

                                <Rectangle Width="1" Fill="{DynamicResource TextSecondaryBrush}"
                                           Opacity="0.3" Margin="8,4"/>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,8"
                                        ToolTip="Удалить выбранную задачу">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" VerticalAlignment="Center"/>
                                        <TextBlock Text="Удалить" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding ClearAllCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteSweepOutline" VerticalAlignment="Center"/>
                                        <TextBlock Text="Очистить" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Border Background="#EEF2FF" CornerRadius="6" Padding="10,4" Margin="8,0,0,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                                                  Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="Ключ = "/>
                                            <Run Text="ID задачи" FontWeight="Bold"/>
                                            <Run Text=" (подпись под узлом). Цвет — "/>
                                            <Run Text="приоритет" FontWeight="Bold"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </materialDesign:Card>

                        <!-- Баннер «Реальный режим» -->
                        <Border Grid.Row="2" Margin="0,0,0,8"
                                Background="#FFF7E6" BorderBrush="#F0C36D" BorderThickness="1"
                                CornerRadius="8" Padding="14,10"
                                Panel.ZIndex="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasManualTasks}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LockOutline" Width="20" Height="20"
                                                          Foreground="#B7791F" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ManualModeHint}" Foreground="#8A5A00"
                                           TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ============================================================ -->
                        <!-- ОСНОВНАЯ СЕТКА С РАЗДЕЛИТЕЛЯМИ                               -->
                        <!-- ============================================================ -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="180"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="200"/>
                            </Grid.RowDefinitions>

                            <!-- ВЕРХНЯЯ СТРОКА: ТАБЛИЦА ЗАДАЧ -->
                            <materialDesign:Card Grid.Row="0" Padding="0" UniformCornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Фильтры + Fullscreen + счётчик -->
                                    <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource AppBackgroundBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="FilterVariant" Width="16" Height="16"
                                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Фильтр:" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </StackPanel>

                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                <RadioButton Content="Все" GroupName="TaskFilter"
                                                             Style="{StaticResource MaterialDesignRadioButton}"
                                                             IsChecked="{Binding IsFilterAll, Mode=TwoWay}"
                                                             Margin="0,0,12,0"/>
                                                <RadioButton Content="Ожидает" GroupName="TaskFilter"
                                                             Style="{StaticResource MaterialDesignRadioButton}"
                                                             IsChecked="{Binding IsFilterPending, Mode=TwoWay}"
                                                             Margin="0,0,12,0"/>
                                                <RadioButton Content="В работе" GroupName="TaskFilter"
                                                             Style="{StaticResource MaterialDesignRadioButton}"
                                                             IsChecked="{Binding IsFilterInProgress, Mode=TwoWay}"
                                                             Margin="0,0,12,0"/>
                                                <RadioButton Content="Выполнено" GroupName="TaskFilter"
                                                             Style="{StaticResource MaterialDesignRadioButton}"
                                                             IsChecked="{Binding IsFilterDone, Mode=TwoWay}"/>
                                            </WrapPanel>

                                            <Button Grid.Column="2"
                                                    Command="{Binding FullscreenTableCommand}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="32" Height="32"
                                                    Margin="0,0,12,0"
                                                    ToolTip="Развернуть таблицу на весь экран">
                                                <materialDesign:PackIcon Kind="Fullscreen" Width="18" Height="18"/>
                                            </Button>

                                            <Border Grid.Column="3" Background="{StaticResource PrimaryBrush}"
                                                    CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Tasks.Count, StringFormat='Всего: {0}'}"
                                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Таблица (основная) -->
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding FilteredTasks}"
                                              SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Background="{DynamicResource SurfaceBrush}"
                                              BorderThickness="0"
                                              RowHeight="40"
                                              ColumnHeaderHeight="40"
                                              VirtualizingPanel.IsVirtualizing="False">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="TextBlock.TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>

                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Приоритет" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding NodeColor, Mode=OneTime}"
                                                                CornerRadius="4" Padding="8,2"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Priority}" Foreground="White"
                                                                       FontWeight="Bold" FontSize="12"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat='#{0}'}" Width="70"/>
                                            <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="2*"/>
                                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Срок" Binding="{Binding DueDisplay}" Width="150"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Кнопки смены статуса (ОСТАВЛЕНЫ RADIOBUTTON) -->
                                    <Border Grid.Row="2" Padding="12" Background="{DynamicResource AppBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Изменить статус:" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <RadioButton Content="Ожидает" GroupName="TaskStatusGroup"
                                                         Style="{StaticResource MaterialDesignRadioButton}"
                                                         Command="{Binding MarkPendingCommand}"
                                                         IsChecked="{Binding SelectedTask.IsPending, Mode=OneWay}"
                                                         Margin="0,0,12,0"/>

                                            <RadioButton Content="В работе" GroupName="TaskStatusGroup"
                                                         Style="{StaticResource MaterialDesignRadioButton}"
                                                         Command="{Binding MarkInProgressCommand}"
                                                         IsChecked="{Binding SelectedTask.IsInProgress, Mode=OneWay}"
                                                         Margin="0,0,12,0"/>

                                            <RadioButton Content="Выполнено" GroupName="TaskStatusGroup"
                                                         Style="{StaticResource MaterialDesignRadioButton}"
                                                         Command="{Binding MarkDoneCommand}"
                                                         IsChecked="{Binding SelectedTask.IsDone, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </materialDesign:Card>

                            <!-- ГОРИЗОНТАЛЬНЫЙ РАЗДЕЛИТЕЛЬ -->
                            <GridSplitter Grid.Row="1" Style="{StaticResource GripRowSplitter}"/>

                            <!-- НИЖНЯЯ СТРОКА: BST + AVL (ВОЗВРАЩЕНО) -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                </Grid.ColumnDefinitions>

                                <!-- BST -->
                                <materialDesign:Card Grid.Column="0" Padding="0" UniformCornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource AppBackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileTree" Width="18" Height="18"
                                                                                  Foreground="{StaticResource PrimaryBrush}"
                                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Text="BST по ID задачи" Margin="8,0,0,0"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Без балансировки → вырождается на отсортированных ID"
                                                               FontSize="11" Margin="26,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Command="{Binding FullscreenBstCommand}"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="32" Height="32" ToolTip="На весь экран">
                                                    <materialDesign:PackIcon Kind="Fullscreen" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="1"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                            <Grid Width="{Binding BstCanvasWidth}"
                                                  Height="{Binding BstCanvasHeight}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Background="Transparent">

                                                <ItemsControl ItemsSource="{Binding BstEdges}" Width="{Binding BstCanvasWidth}" Height="{Binding BstCanvasHeight}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                                  Stroke="#94A3B8" StrokeThickness="1.5"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{Binding BstNodes}" Width="{Binding BstCanvasWidth}" Height="{Binding BstCanvasHeight}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Grid Width="40" Height="40">
                                                                    <Ellipse Fill="{Binding NodeColor}" Stroke="White" StrokeThickness="2"
                                                                             Width="40" Height="40"
                                                                             RenderTransformOrigin="0.5,0.5"
                                                                             Loaded="Ellipse_Loaded"/>
                                                                    <TextBlock Text="{Binding PriorityText}"
                                                                                Foreground="White" FontWeight="Bold"
                                                                                FontSize="14"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding IdText}" FontSize="10" Foreground="#64748B"
                                                                            HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </ScrollViewer>

                                        <TextBlock Grid.Row="1"
                                                   Text="Нет задач — добавьте кнопкой «+10»"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontStyle="Italic" Opacity="0.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BstNodes.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- ВЕРТИКАЛЬНЫЙ РАЗДЕЛИТЕЛЬ -->
                                <GridSplitter Grid.Column="1" Style="{StaticResource GripColumnSplitter}"/>

                                <!-- AVL -->
                                <materialDesign:Card Grid.Column="2" Padding="0" UniformCornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource AppBackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileTree" Width="18" Height="18"
                                                                                  Foreground="{StaticResource SuccessBrush}"
                                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Text="AVL по ID задачи" Margin="8,0,0,0"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Самобалансирующееся → высота ~log₂(N) всегда"
                                                               FontSize="11" Margin="26,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Command="{Binding FullscreenAvlCommand}"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="32" Height="32" ToolTip="На весь экран">
                                                    <materialDesign:PackIcon Kind="Fullscreen" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="1"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="Transparent">
                                            <Grid Width="{Binding AvlCanvasWidth}"
                                                  Height="{Binding AvlCanvasHeight}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Background="Transparent">

                                                <ItemsControl ItemsSource="{Binding AvlEdges}" Width="{Binding AvlCanvasWidth}" Height="{Binding AvlCanvasHeight}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                                  Stroke="#94A3B8" StrokeThickness="1.5"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{Binding AvlNodes}" Width="{Binding AvlCanvasWidth}" Height="{Binding AvlCanvasHeight}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Grid Width="40" Height="40">
                                                                    <Ellipse Fill="{Binding NodeColor}" Stroke="White" StrokeThickness="2"
                                                                             Width="40" Height="40"
                                                                             RenderTransformOrigin="0.5,0.5"
                                                                             Loaded="Ellipse_Loaded"/>
                                                                    <TextBlock Text="{Binding PriorityText}"
                                                                                Foreground="White" FontWeight="Bold"
                                                                                FontSize="14"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding IdText}" FontSize="10" Foreground="#64748B"
                                                                            HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </ScrollViewer>

                                        <TextBlock Grid.Row="1"
                                                   Text="Нет задач — добавьте кнопкой «+10»"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontStyle="Italic" Opacity="0.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AvlNodes.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </materialDesign:Card>
                            </Grid>
                        </Grid>
                    </Grid>
                </materialDesign:DialogHost>

                <!-- ============================================================ -->
                <!-- ПОЛНОЭКРАННЫЙ ПРОСМОТР (BST / AVL / ТАБЛИЦА)                 -->
                <!-- ============================================================ -->
                <Grid Background="#CC0F172A"
                      Visibility="{Binding IsFullscreenOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Panel.ZIndex="2000">

                    <Border HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="32"
                            Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                        </Border.Effect>

                        <Grid>

                            <!-- BST FULLSCREEN -->
                            <Grid Visibility="{Binding IsBstFullscreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="24,16" Background="{StaticResource PrimaryBrush}" CornerRadius="16,16,0,0">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <materialDesign:PackIcon Kind="FileTree" Width="24" Height="24" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="BST (без балансировки) — ключ = ID задачи"
                                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BstInfo}" Foreground="White" Opacity="0.85"
                                                       FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Command="{Binding CloseFullscreenCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Foreground="White"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                ToolTip="Закрыть">
                                            <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                                        </Button>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid Width="{Binding BstCanvasWidth}" Height="{Binding BstCanvasHeight}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl ItemsSource="{Binding BstEdges}" Width="{Binding BstCanvasWidth}" Height="{Binding BstCanvasHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                          Stroke="#94A3B8" StrokeThickness="1.5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding BstNodes}" Width="{Binding BstCanvasWidth}" Height="{Binding BstCanvasHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Grid Width="40" Height="40">
                                                            <Ellipse Fill="{Binding NodeColor}" Stroke="White" StrokeThickness="2"
                                                                     Width="40" Height="40"
                                                                     RenderTransformOrigin="0.5,0.5"
                                                                     Loaded="Ellipse_Loaded"/>
                                                            <TextBlock Text="{Binding PriorityText}" Foreground="White" FontWeight="Bold"
                                                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding IdText}" FontSize="10" Foreground="#64748B"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <!-- AVL FULLSCREEN -->
                            <Grid Visibility="{Binding IsAvlFullscreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SuccessBrush}" CornerRadius="16,16,0,0">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <materialDesign:PackIcon Kind="FileTree" Width="24" Height="24" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="AVL (самобалансирующееся) — ключ = ID задачи"
                                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AvlInfo}" Foreground="White" Opacity="0.85"
                                                       FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Command="{Binding CloseFullscreenCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Foreground="White"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                ToolTip="Закрыть">
                                            <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                                        </Button>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid Width="{Binding AvlCanvasWidth}" Height="{Binding AvlCanvasHeight}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl ItemsSource="{Binding AvlEdges}" Width="{Binding AvlCanvasWidth}" Height="{Binding AvlCanvasHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                          Stroke="#94A3B8" StrokeThickness="1.5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding AvlNodes}" Width="{Binding AvlCanvasWidth}" Height="{Binding AvlCanvasHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Grid Width="40" Height="40">
                                                            <Ellipse Fill="{Binding NodeColor}" Stroke="White" StrokeThickness="2"
                                                                     Width="40" Height="40"
                                                                     RenderTransformOrigin="0.5,0.5"
                                                                     Loaded="Ellipse_Loaded"/>
                                                            <TextBlock Text="{Binding PriorityText}" Foreground="White" FontWeight="Bold"
                                                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding IdText}" FontSize="10" Foreground="#64748B"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <!-- TABLE FULLSCREEN -->
                            <Grid Visibility="{Binding IsTableFullscreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="24,16" Background="{StaticResource PrimaryBrush}" CornerRadius="16,16,0,0">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="24" Height="24"
                                                                      Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="Список задач" Foreground="White" FontSize="18"
                                                       FontWeight="SemiBold" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Tasks.Count, StringFormat='Всего: {0}'}"
                                                       Foreground="White" Opacity="0.85" FontSize="13"
                                                       Margin="16,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FilteredTasks.Count, StringFormat='Показано: {0}'}"
                                                       Foreground="White" Opacity="0.65" FontSize="13"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Command="{Binding CloseFullscreenCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Foreground="White"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                ToolTip="Закрыть">
                                            <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                                        </Button>
                                    </DockPanel>
                                </Border>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding FilteredTasks}"
                                          SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="{DynamicResource SurfaceBrush}"
                                          BorderThickness="0"
                                          RowHeight="48"
                                          ColumnHeaderHeight="48"
                                          VirtualizingPanel.IsVirtualizing="False"
                                          Margin="16">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Setter Property="TextBlock.TextDecorations" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Приоритет" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding NodeColor, Mode=OneTime}"
                                                            CornerRadius="4" Padding="10,3"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Priority}"
                                                                   Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="ID"
                                                            Binding="{Binding Id, StringFormat='#{0}'}"
                                                            Width="80"/>

                                        <DataGridTextColumn Header="Задача"
                                                            Binding="{Binding Title}"
                                                            Width="2*"/>

                                        <DataGridTextColumn Header="Описание"
                                                            Binding="{Binding Description}"
                                                            Width="1.5*"/>

                                        <DataGridTextColumn Header="Срок"
                                                            Binding="{Binding DueDisplay}"
                                                            Width="150"/>

                                        <DataGridTextColumn Header="Статус"
                                                            Binding="{Binding StatusLabel}"
                                                            Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</UserControl>