<UserControl x:Class="StructLab.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,40" MaxWidth="900" HorizontalAlignment="Center">

            <TextBlock Text="Добро пожаловать в StructLab"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Интерактивная библиотека структур данных на C++"
                       FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,40"/>

            <UniformGrid Columns="2">
                <materialDesign:Card Margin="8" Padding="24" UniformCornerRadius="12">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="FormatListBulleted"
                                                  Width="40" Height="40"
                                                  Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Структуры данных"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,16,0,8"/>
                        <TextBlock Text="Списки, стеки, очереди, деревья. Всё о работе с памятью."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="8" Padding="24" UniformCornerRadius="12">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="LanguageCpp"
                                                  Width="40" Height="40"
                                                  Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Современный C++"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,16,0,8"/>
                        <TextBlock Text="От указателей до шаблонов. От ручного управления до ООП."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="8" Padding="24" UniformCornerRadius="12">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ApplicationBracesOutline"
                                                  Width="40" Height="40"
                                                  Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Практика"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,16,0,8"/>
                        <TextBlock Text="Восемь лабораторных работ, каждая — реальная задача."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="8" Padding="24" UniformCornerRadius="12">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ViewDashboardOutline"
                                                  Width="40" Height="40"
                                                  Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Единый хаб"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,16,0,8"/>
                        <TextBlock Text="Все лабы в одном приложении, единый интерфейс."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <Border Margin="8,40,8,0"
                    Padding="20"
                    Background="#EEF2FF"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                              Width="24" Height="24"
                                              Foreground="{StaticResource PrimaryBrush}"
                                              VerticalAlignment="Center"/>
                    <TextBlock Text="Выберите лабораторную работу в левом меню, чтобы начать."
                               Margin="12,0,0,0"
                               FontSize="14"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>