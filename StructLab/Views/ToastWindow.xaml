<Window x:Class="StructLab.Views.Notifications.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Уведомление"
        Width="400" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border x:Name="RootBorder" Background="White"
            CornerRadius="12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="3" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА (зелёная) -->
            <Border Grid.Row="0"
                    Background="#10B981"
                    CornerRadius="12,12,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0"
                                              Kind="BellRing"
                                              Width="22" Height="22"
                                              Foreground="White"
                                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Напоминание"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="White"
                            Width="28" Height="28"
                            Click="CloseButton_Click"
                            ToolTip="Закрыть">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ТЕЛО (белое) -->
            <Border Grid.Row="1" Padding="18,16">
                <StackPanel>
                    <!-- Эмодзи-восклицательные знаки + текст -->
                    <TextBlock TextWrapping="Wrap"
                               FontSize="14"
                               LineHeight="22">
                        <Run Text="❗" FontSize="18" Foreground="#EF4444" FontWeight="Bold"/>
                        <Run Text="❗" FontSize="18" Foreground="#EF4444" FontWeight="Bold"/>
                        <Run Text="❗" FontSize="18" Foreground="#EF4444" FontWeight="Bold"/>
                        <Run Text=" " FontSize="14"/>
                        <Run Text="{Binding Message, Mode=OneWay}"
                             Foreground="#EF4444"
                             FontWeight="SemiBold"/>
                    </TextBlock>

                    <!-- Время -->
                    <TextBlock Text="{Binding TimeText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>