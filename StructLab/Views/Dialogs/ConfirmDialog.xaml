<UserControl x:Class="StructLab.Views.Dialogs.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <materialDesign:Card UniformCornerRadius="16" Width="460">
        <StackPanel>

            <!-- Шапка -->
            <Border Background="{StaticResource PrimaryBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HelpCircleOutline"
                                              Width="28" Height="28"
                                              Foreground="White"
                                              VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Содержимое -->
            <TextBlock Text="{Binding Text}"
                       Margin="24,24,24,24"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- Футер -->
            <Border Background="{DynamicResource AppBackgroundBrush}"
                    CornerRadius="0,0,16,16"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding CancelText}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="False"
                            Margin="0,0,8,0"/>
                    <Button Content="{Binding OkText}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="True"
                            IsDefault="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </materialDesign:Card>
</UserControl>