<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:StructLab.Views.Dialogs"
                    xmlns:models="clr-namespace:StructLab.Models.Dialogs">

    <DataTemplate DataType="{x:Type models:MessageDialogModel}">
        <dialogs:MessageDialog/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:ConfirmDialogModel}">
        <dialogs:ConfirmDialog/>
    </DataTemplate>

</ResourceDictionary>