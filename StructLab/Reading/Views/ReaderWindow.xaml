<Window x:Class="StructLab.Reading.Views.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Читалка — StructLab"
        Height="900" Width="1400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- ЛЕВАЯ ПАНЕЛЬ: поиск / оглавление -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>

                <Border DockPanel.Dock="Top" Padding="20,22,20,16"
                        BorderBrush="#1F2937" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookOpenVariant" Width="28" Height="28"
                                                      Foreground="{StaticResource PrimaryHoverBrush}"
                                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Читалка" Foreground="White" FontSize="22" FontWeight="Bold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Викитека и EPUB"
                                   Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                        <Button Command="{Binding LoadEpubCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="White" BorderBrush="White"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                ToolTip="Открыть локальный файл .epub">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileUploadOutline" VerticalAlignment="Center"/>
                                <TextBlock Text="Загрузить EPUB" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Поиск -->
                <Border DockPanel.Dock="Top" Padding="16,16,16,8"
                        Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Автор или название книги"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="White"
                                 KeyDown="SearchBox_KeyDown"
                                 Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center"/>
                                    <TextBlock Text="Найти" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="White" BorderBrush="White">
                                <materialDesign:PackIcon Kind="Close"/>
                            </Button>
                        </Grid>

                        <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Шапка открытой книги: название, прогресс, режимы -->
                <Border DockPanel.Dock="Top" Padding="16,16,16,10"
                        Visibility="{Binding IsBookHeaderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentBook.Title}"
                                   Foreground="White" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BookSubtitle}"
                                   Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasBookSubtitle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ProgressText}"
                                   Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasProgressText, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Режимы левой панели -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Content="Оглавление" GroupName="LeftMode" Margin="0,0,14,0"
                                         Foreground="White"
                                         IsChecked="{Binding IsTocMode, Mode=OneWay}"
                                         Command="{Binding ShowTocCommand}"
                                         Style="{StaticResource MaterialDesignRadioButton}"/>
                            <RadioButton Content="Закладки" GroupName="LeftMode"
                                         Foreground="White"
                                         IsChecked="{Binding IsBookmarksMode, Mode=OneWay}"
                                         Command="{Binding ShowBookmarksCommand}"
                                         Style="{StaticResource MaterialDesignRadioButton}"/>
                        </StackPanel>

                        <!-- Поиск по тексту книги -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding BookSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="BookSearchBox"
                                     materialDesign:HintAssist.Hint="Поиск по тексту книги"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Foreground="White"
                                     KeyDown="BookSearchBox_KeyDown"
                                     Margin="0,0,6,0"/>
                            <Button Grid.Column="1"
                                    Command="{Binding SearchInBookCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    AutomationProperties.Name="SearchInBook"
                                    ToolTip="Искать по всем главам"
                                    Width="32" Height="32"
                                    VerticalAlignment="Bottom">
                                <materialDesign:PackIcon Kind="Magnify" Foreground="White"/>
                            </Button>
                        </Grid>

                        <Button Command="{Binding ShowSearchCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="White" BorderBrush="White"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center"/>
                                <TextBlock Text="К поиску" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Мои книги (EPUB) -->
                <Border DockPanel.Dock="Bottom" Padding="16,10,16,14"
                        BorderBrush="#1F2937" BorderThickness="0,1,0,0"
                        Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Мои книги (EPUB)"
                                   Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Пока нет загруженных книг"
                                   Foreground="#64748B" FontSize="11" FontStyle="Italic"
                                   Visibility="{Binding HasNoEpubBooks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ListBox ItemsSource="{Binding EpubBooks}"
                                 MaxHeight="200"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Padding="0"
                                 Visibility="{Binding HasEpubBooks, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="White"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#94A3B8"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.OpenEpubCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Открыть книгу"
                                                Width="32" Height="32"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                                                      Width="18" Height="18"
                                                                      Foreground="White"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Grid>
                    <!-- Результаты поиска -->
                    <ListBox ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="8,8,8,16"
                             Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Snippet}" Foreground="#94A3B8" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="44"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Оглавление -->
                    <ListBox ItemsSource="{Binding CurrentBook.Chapters}"
                             SelectedItem="{Binding CurrentChapter, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="8,8,8,16"
                             Visibility="{Binding IsTocMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Статус главы: прочитано / в процессе / не начато -->
                                    <Grid Grid.Column="0" Width="16" Height="16"
                                          VerticalAlignment="Top" Margin="0,3,0,0">
                                        <materialDesign:PackIcon x:Name="noneIcon" Kind="CircleOutline"
                                                                  Width="13" Height="13"
                                                                  Foreground="#64748B"
                                                                  Visibility="Visible"/>
                                        <materialDesign:PackIcon x:Name="readIcon" Kind="CheckCircle"
                                                                  Width="16" Height="16"
                                                                  Foreground="#4ADE80"
                                                                  Visibility="Collapsed"/>
                                        <materialDesign:PackIcon x:Name="nowIcon" Kind="BookOpenPageVariant"
                                                                  Width="16" Height="16"
                                                                  Foreground="{StaticResource PrimaryHoverBrush}"
                                                                  Visibility="Collapsed"/>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding Number}"
                                               Foreground="#94A3B8" FontSize="12"
                                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Title}"
                                               Foreground="White" TextWrapping="Wrap"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                        <Setter TargetName="noneIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="readIcon" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="noneIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="readIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="nowIcon" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Закладки -->
                    <Grid Visibility="{Binding IsBookmarksMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Пока нет закладок. Нажмите на значок закладки в тулбаре."
                                   Foreground="#64748B" FontSize="12" FontStyle="Italic"
                                   TextWrapping="Wrap" Margin="18,12,18,0"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding HasNoBookmarks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ListBox ItemsSource="{Binding Bookmarks}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Padding="8,8,8,16"
                                 Visibility="{Binding HasBookmarks, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,6"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Command="{Binding DataContext.OpenBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                HorizontalContentAlignment="Left"
                                                Padding="0"
                                                ToolTip="Перейти к закладке">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="White"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#94A3B8"
                                                           FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                AutomationProperties.Name="DeleteBookmark"
                                                ToolTip="Удалить закладку"
                                                Width="30" Height="30" Margin="4,0,0,0"
                                                VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                      Width="16" Height="16"
                                                                      Foreground="#94A3B8"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Результаты поиска по тексту книги -->
                    <Grid Visibility="{Binding IsBookSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding BookSearchSummary}"
                                       Foreground="#94A3B8" FontSize="11" Margin="16,8,16,4"
                                       Visibility="{Binding HasBookSearchSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Ничего не найдено"
                                       Foreground="#64748B" FontSize="12" FontStyle="Italic"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,24,0,0"
                                       Visibility="{Binding HasNoBookSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ListBox ItemsSource="{Binding BookSearchResults}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Padding="8,8,8,16"
                                     Visibility="{Binding HasBookSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,6"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="b" Background="Transparent" CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenBookSearchHitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                HorizontalContentAlignment="Left"
                                                Padding="0"
                                                ToolTip="Перейти к фрагменту">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="White"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Snippet}" Foreground="#94A3B8"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- ЧИТАЛКА -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Тулбар -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PrevChapterCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                AutomationProperties.Name="PrevChapter"
                                ToolTip="Предыдущая глава" Width="36" Height="36">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22"/>
                        </Button>
                        <Button Command="{Binding NextChapterCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                AutomationProperties.Name="NextChapter"
                                ToolTip="Следующая глава" Width="36" Height="36">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22"/>
                        </Button>

                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentBook.Title}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            <TextBlock Text="{Binding ChapterPositionText}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Button Command="{Binding AddBookmarkCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                AutomationProperties.Name="AddBookmark"
                                ToolTip="Добавить/снять закладку" Width="36" Height="36"
                                Margin="8,0,0,0">
                            <materialDesign:PackIcon Kind="BookmarkPlusOutline" Width="20" Height="20"/>
                        </Button>

                        <Button Command="{Binding ReloadCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                AutomationProperties.Name="ReloadBook"
                                ToolTip="Перезагрузить с сервера" Width="36" Height="36"
                                Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Шрифт -->
                        <TextBlock Text="Шрифт" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                        <Slider Value="{Binding FontSize, Mode=TwoWay}"
                                Minimum="12" Maximum="28" Width="100"
                                VerticalAlignment="Center"
                                TickFrequency="2" IsSnapToTickEnabled="True"
                                Margin="0,0,16,0"/>

                        <!-- Тема -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Светлая" GroupName="Theme" Margin="0,0,6,0"
                                         IsChecked="{Binding IsThemeLight, Mode=TwoWay}"
                                         Style="{StaticResource MaterialDesignRadioButton}"/>
                            <RadioButton Content="Сепия" GroupName="Theme" Margin="0,0,6,0"
                                         IsChecked="{Binding IsThemeSepia, Mode=TwoWay}"
                                         Style="{StaticResource MaterialDesignRadioButton}"/>
                            <RadioButton Content="Тёмная" GroupName="Theme"
                                         IsChecked="{Binding IsThemeDark, Mode=TwoWay}"
                                         Style="{StaticResource MaterialDesignRadioButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Предупреждение о неполной загрузке -->
            <Border Grid.Row="1" HorizontalAlignment="Stretch"
                    Margin="16,10,16,0" CornerRadius="8" Padding="14,10"
                    Background="#FFF7E6" BorderBrush="#F0C36D" BorderThickness="1"
                    Visibility="{Binding HasBookWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOutline" Width="20" Height="20"
                                              Foreground="#B7791F" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BookWarning}" Foreground="#8A5A00"
                               TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Содержимое -->
            <Grid Grid.Row="2">
                <!-- Плашка статуса -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                        Background="{DynamicResource SidebarBrush}" CornerRadius="8" Padding="16,8"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                  Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="White"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Индикатор загрузки -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Width="60" Height="60"
                             Visibility="{Binding IsLoadingBook, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Собственно текст -->
                <FlowDocumentReader x:Name="Reader"
                                    ViewingMode="Scroll"
                                    Zoom="100"
                                    IsFindEnabled="True"
                                    IsPrintEnabled="False"
                                    IsTwoPageViewEnabled="False"
                                    Background="Transparent"
                                    Padding="16"
                                    Visibility="{Binding HasBook, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Заглушка "выберите книгу" -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoBook, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="80" Height="80"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="Выберите книгу из результатов слева или загрузите EPUB"
                               FontSize="16" Margin="0,16,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
