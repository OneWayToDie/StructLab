<Application x:Class="StructLab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- ==========================================
                     1. БАЗОВАЯ ТЕМА MATERIAL DESIGN
                     BundledTheme — самый простой способ
                =========================================== -->
                <materialDesign:BundledTheme BaseTheme="Light"
                                              PrimaryColor="Indigo"
                                              SecondaryColor="Amber"/>

                <!-- 2. Стандартные стили Material Design для всех контролов -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml"/>

                <!-- ==========================================
                     3. ВАШИ КАСТОМНЫЕ СТИЛИ (ПОВЕРХ Material Design)
                     Здесь можно переопределять цвета
                =========================================== -->
                <ResourceDictionary Source="Themes/Colors.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>