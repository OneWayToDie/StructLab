<Window x:Class="StructLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:StructLab.ViewModels"
        Title="StructLab — Лабораторный практикум по C++"
        Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        TextElement.FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- ==========================================================
         DialogHost оборачивает ВСЁ содержимое окна.
         Это позволяет диалогам затемнять весь экран,
         а не только правую панель.
    =========================================================== -->
    <materialDesign:DialogHost IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
                                Identifier="RootDialog">

        <materialDesign:DialogHost.DialogContent>

            <!-- ==============================================
                 ДИАЛОГ НАСТРОЕК
                 Карточка с шапкой, содержимым и футером
            =============================================== -->
            <materialDesign:Card UniformCornerRadius="16" Width="520">
                <StackPanel>

                    <!-- Шапка диалога -->
                    <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="16,16,0,0"
                            Padding="24,20">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                      Width="28" Height="28"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Настройки"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Содержимое -->
                    <StackPanel Margin="24,20,24,8">

                        <!-- Заглушка-подсказка -->
                        <Border Background="#EEF2FF"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                          Width="20" Height="20"
                                                          Foreground="{StaticResource PrimaryBrush}"
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Раздел в разработке. Скоро здесь появятся настройки темы, языка и данных."
                                           Margin="10,0,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="380"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Пункт: Тема оформления -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Тема оформления"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Светлая или тёмная"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsEnabled="False"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,8,0,16"/>

                        <!-- Пункт: Язык интерфейса -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Язык интерфейса"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Русский"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    IsEnabled="False"
                                    Content="Изменить"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,8,0,16"/>

                        <!-- Пункт: О приложении -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="О приложении"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="StructLab v0.1 · Лабораторный практикум"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Футер -->
                    <Border Background="{StaticResource AppBackgroundBrush}"
                            CornerRadius="0,0,16,16"
                            Padding="24,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Закрыть"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                    IsDefault="True"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </materialDesign:Card>

        </materialDesign:DialogHost.DialogContent>

        <!-- ==========================================================
             ОСНОВНОЕ СОДЕРЖИМОЕ ОКНА
             (всё, что было раньше, обёрнуто в этот Grid)
        =========================================================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==========================================
                 ЛЕВАЯ ПАНЕЛЬ (SIDEBAR)
            =========================================== -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Background="{StaticResource SidebarBrush}">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>

                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="24,28,24,20"
                            BorderBrush="#1F2937"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CubeOutline"
                                                          Width="32" Height="32"
                                                          Foreground="{StaticResource PrimaryHoverBrush}"
                                                          VerticalAlignment="Center"/>
                                <TextBlock Text="StructLab"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Лабораторный практикум по C++"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Labs}"
                             SelectedItem="{Binding SelectedLab, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="16,12"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="{StaticResource SidebarHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding Number, StringFormat='ЛАБОРАТОРНАЯ {0}'}"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextOnDarkBrush}"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ==========================================
                 ПРАВАЯ ПАНЕЛЬ
                 Разделена на шапку с шестерёнкой и контент
            =========================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== ШАПКА С КНОПКОЙ НАСТРОЕК ===== -->
                <Border Grid.Row="0"
                        Padding="16,12,20,12"
                        Background="Transparent">
                    <Grid>
                        <!-- Слева в шапке можно позже добавить хлебные крошки -->
                        <TextBlock Text=""
                                   VerticalAlignment="Center"/>

                        <!-- Справа — иконка-шестерёнка -->
                        <Button HorizontalAlignment="Right"
                                Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Настройки"
                                Width="40" Height="40">
                            <materialDesign:PackIcon Kind="Cog"
                                                      Width="22" Height="22"
                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== КОНТЕНТ ЛАБЫ ===== -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentView}"
                                Margin="0,0,0,0">
                    <ContentControl.RenderTransform>
                        <TranslateTransform/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>

    </materialDesign:DialogHost>

    <!-- ==========================================
         АНИМАЦИЯ ПРИ ЗАПУСКЕ
    =========================================== -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sidebar"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-300" To="0"
                                     Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>